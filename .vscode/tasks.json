{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "deploy-api",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "deploy.deploy",
                "-df",
            ],
            "problemMatcher": []
        },
                {
            "type": "shell",
            "label": "tf-apply",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "deploy.deploy",
                "-a",
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "start-backend",
            "problemMatcher": [],
            "dependsOrder": "sequence",
            "dependsOn": [
                "start-db",
                "start-api"
            ]
        },
        {
            "type": "shell",
            "label": "fill-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--fill"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "init-db-prod",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--init-prod",
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "fill-db-prod",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--fill-prod",
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "stop-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--stop"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "start-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--start"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "reset-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "scripts.db_setup",
                "--reset"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "start-api",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "-m",
                "src.app"
            ],
            "problemMatcher": []
        },
    ]
}