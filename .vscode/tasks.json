{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "fill-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "scripts/db_setup.py",
                "--fill"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "stop-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "scripts/db_setup.py",
                "--stop"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "start-db",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "scripts/db_setup.py",
                "--start"
            ],
            "problemMatcher": []
        }
    ]
}